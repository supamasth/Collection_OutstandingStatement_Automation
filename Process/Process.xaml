    <If Condition="[Not blnIsFreshRequest]" DisplayName="If Reply/Forward to a Robot Email - Forward to Collection Team and Stop (skips Sections 3-6 entirely)">
      <If.Then>
        <Sequence DisplayName="Forward to Collection Team">
          <Assign sap2010:Annotation.AnnotationText="Circuit breaker (independent of root cause): if this subject already shows 2+ FW: prefixes, forwarding again would keep growing a loop instead of breaking it. Route to System Exception for a human instead." DisplayName="Count FW: Occurrences in Subject">
            <Assign.To>
              <OutArgument x:TypeArguments="x:Int32">[intFwCount]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:Int32">[Regex.Matches(strSubjectTrimmed, "FW:", RegexOptions.IgnoreCase).Count]</InArgument>
            </Assign.Value>
          </Assign>
          <If Condition="[intFwCount &gt;= 2]" DisplayName="If Circuit Breaker Triggered - Possible Mail Loop">
            <If.Then>
              <Sequence DisplayName="Escalate as System Exception Instead of Forwarding Again">
                <ui:LogMessage DisplayName="Log [CircuitBreaker] Possible Mail Loop" Level="Error" Message="[&quot;[CircuitBreaker] Subject has &quot; + intFwCount.ToString + &quot; 'FW:' occurrences - looks like a reply/forward loop, not forwarding again. Sender=&quot; + strSenderEmail + &quot; | Subject=&quot; + strSubjectTrimmed]" />
                <TryCatch DisplayName="TryCatch Alert and Move (best-effort - do not crash the run over a loop-detection item)">
                  <TryCatch.Try>
                    <Sequence>
                      <ui:InvokeWorkflowFile DisplayName="Invoke SendAlertEmail (Possible Mail Loop)" WorkflowFileName="Framework\SendAlertEmail.xaml">
                        <ui:InvokeWorkflowFile.Arguments>
                          <InArgument x:TypeArguments="scg:Dictionary(x:String, x:Object)" x:Key="in_Config">[in_Config]</InArgument>
                          <InArgument x:TypeArguments="x:String" x:Key="in_TransactionID">[in_TransactionID]</InArgument>
                          <InArgument x:TypeArguments="x:String" x:Key="in_SenderEmail">[strSenderEmail]</InArgument>
                          <InArgument x:TypeArguments="x:String" x:Key="in_CustomerID">[""]</InArgument>
                          <InArgument x:TypeArguments="x:String" x:Key="in_ExceptionType">PossibleMailLoop</InArgument>
                          <InArgument x:TypeArguments="x:String" x:Key="in_ExceptionMessage">[&quot;Subject contains &quot; + intFwCount.ToString + &quot; 'FW:' prefixes, suggesting a reply/forward loop. Full subject: &quot; + strSubject + &quot; | Sender: &quot; + strSenderEmail + &quot;. Robot did NOT forward again. Please check this item manually in Outlook and, if this is a genuine loop, check the OutstandingRequest intake rule and Mail_Exception_CC mailbox for a forward-back path.&quot;]</InArgument>
                          <InArgument x:TypeArguments="x:String" x:Key="in_ScreenshotPath">[""]</InArgument>
                        </ui:InvokeWorkflowFile.Arguments>
                      </ui:InvokeWorkflowFile>
                      <ui:InvokeWorkflowFile DisplayName="Invoke MoveAndMarkEmail (ForwardedToCollection)" WorkflowFileName="Process\MoveAndMarkEmail.xaml">
                        <ui:InvokeWorkflowFile.Arguments>
                          <InArgument x:TypeArguments="snm:MailMessage" x:Key="in_MailItem">[in_MailItem]</InArgument>
                          <InArgument x:TypeArguments="x:String" x:Key="in_TargetFolder">[in_Config("OutlookFolder_ForwardedToCollection").ToString]</InArgument>
                        </ui:InvokeWorkflowFile.Arguments>
                      </ui:InvokeWorkflowFile>
                    </Sequence>
                  </TryCatch.Try>
                  <TryCatch.Catches>
                    <Catch x:TypeArguments="s:Exception">
                      <ActivityAction x:TypeArguments="s:Exception">
                        <ActivityAction.Argument>
                          <DelegateInArgument x:TypeArguments="s:Exception" Name="exLoop" />
                        </ActivityAction.Argument>
                        <ui:LogMessage DisplayName="Log [CircuitBreaker] Alert/Move Failed" Level="Error" Message="[&quot;[CircuitBreaker] Alert email or move failed (item may still be sitting unmoved in the intake folder, but it was already marked read at fetch so it will not be reprocessed): &quot; + exLoop.Message]" />
                      </ActivityAction>
                    </Catch>
                  </TryCatch.Catches>
                </TryCatch>
                <Assign DisplayName="Set Status = SystemException (Circuit Breaker)">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:String">[out_TransactionStatus]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:String">SystemException</InArgument>
                  </Assign.Value>
                </Assign>
              </Sequence>
            </If.Then>
            <If.Else>
              <TryCatch sap2010:Annotation.AnnotationText="Atomic by construction: the forward email (SendOutlookMail) is irreversible once sent, so if the Move that follows it fails, we must NOT let the exception bubble up to Main's retry loop - that would re-invoke this whole transaction and re-send ANOTHER forward. Instead, catch locally, alert the admin directly, and terminate this transaction as SystemException without re-throwing." DisplayName="TryCatch Forward and Move (atomic - do not let Main retry re-send the forward)">
                <TryCatch.Try>
                  <Sequence DisplayName="Forward Then Move">
                    <ui:InvokeWorkflowFile DisplayName="Invoke ForwardToCollectionTeam" WorkflowFileName="Process\ForwardToCollectionTeam.xaml">
                      <ui:InvokeWorkflowFile.Arguments>
                        <InArgument x:TypeArguments="scg:Dictionary(x:String, x:Object)" x:Key="in_Config">[in_Config]</InArgument>
                        <InArgument x:TypeArguments="snm:MailMessage" x:Key="in_MailItem">[in_MailItem]</InArgument>
                        <InArgument x:TypeArguments="x:String" x:Key="in_SenderEmail">[strSenderEmail]</InArgument>
                      </ui:InvokeWorkflowFile.Arguments>
                    </ui:InvokeWorkflowFile>
                    <ui:InvokeWorkflowFile DisplayName="Invoke MoveAndMarkEmail (ForwardedToCollection)" WorkflowFileName="Process\MoveAndMarkEmail.xaml">
                      <ui:InvokeWorkflowFile.Arguments>
                        <InArgument x:TypeArguments="snm:MailMessage" x:Key="in_MailItem">[in_MailItem]</InArgument>
                        <InArgument x:TypeArguments="x:String" x:Key="in_TargetFolder">[in_Config("OutlookFolder_ForwardedToCollection").ToString]</InArgument>
                      </ui:InvokeWorkflowFile.Arguments>
                    </ui:InvokeWorkflowFile>
                    <Assign DisplayName="Set Status = Forwarded">
                      <Assign.To>
                        <OutArgument x:TypeArguments="x:String">[out_TransactionStatus]</OutArgument>
                      </Assign.To>
                      <Assign.Value>
                        <InArgument x:TypeArguments="x:String">Forwarded</InArgument>
                      </Assign.Value>
                    </Assign>
                  </Sequence>
                </TryCatch.Try>
                <TryCatch.Catches>
                  <Catch x:TypeArguments="s:Exception">
                    <ActivityAction x:TypeArguments="s:Exception">
                      <ActivityAction.Argument>
                        <DelegateInArgument x:TypeArguments="s:Exception" Name="exFwd" />
                      </ActivityAction.Argument>
                      <Sequence DisplayName="Handle Forward/Move Failure Without Retrying">
                        <ui:LogMessage DisplayName="Log [Forward] Move Failed After Send - Not Retrying" Level="Error" Message="[&quot;[Forward] The forward email may have already been sent, but the move/mark-as-read step failed: &quot; + exFwd.Message + &quot;. NOT retrying (would re-send the forward) - escalating as SystemException instead.&quot;]" />
                        <ui:InvokeWorkflowFile DisplayName="Invoke SendAlertEmail (Forward Move Failure)" WorkflowFileName="Framework\SendAlertEmail.xaml">
                          <ui:InvokeWorkflowFile.Arguments>
                            <InArgument x:TypeArguments="scg:Dictionary(x:String, x:Object)" x:Key="in_Config">[in_Config]</InArgument>
                            <InArgument x:TypeArguments="x:String" x:Key="in_TransactionID">[in_TransactionID]</InArgument>
                            <InArgument x:TypeArguments="x:String" x:Key="in_SenderEmail">[strSenderEmail]</InArgument>
                            <InArgument x:TypeArguments="x:String" x:Key="in_CustomerID">[""]</InArgument>
                            <InArgument x:TypeArguments="x:String" x:Key="in_ExceptionType">ForwardMoveFailure</InArgument>
                            <InArgument x:TypeArguments="x:String" x:Key="in_ExceptionMessage">[&quot;Forward to Collection team may have already been sent, but moving/marking the source item into OutlookFolder_ForwardedToCollection failed: &quot; + exFwd.ToString + &quot;. Check that this folder exists in Outlook, and manually move the source item (Subject: &quot; + strSubject + &quot;) so it is not reprocessed.&quot;]</InArgument>
                            <InArgument x:TypeArguments="x:String" x:Key="in_ScreenshotPath">[""]</InArgument>
                          </ui:InvokeWorkflowFile.Arguments>
                        </ui:InvokeWorkflowFile>
                        <Assign DisplayName="Set Status = SystemException (Forward/Move Failure)">
                          <Assign.To>
                            <OutArgument x:TypeArguments="x:String">[out_TransactionStatus]</OutArgument>
                          </Assign.To>
                          <Assign.Value>
                            <InArgument x:TypeArguments="x:String">SystemException</InArgument>
                          </Assign.Value>
                        </Assign>
                      </Sequence>
                    </ActivityAction>
                  </Catch>
                </TryCatch.Catches>
              </TryCatch>
            </If.Else>
          </If>

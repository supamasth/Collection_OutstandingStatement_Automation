    <Assign sap2010:Annotation.AnnotationText="Filters on 'is purely digits' rather than relying only on Skip(7) to land past the header row - a real Document No. is always numeric, so this excludes the 'Document no' header label (and any other stray text row) regardless of exactly how many metadata/header rows precede the data in the resaved file. Skip(7) is kept as a coarse first pass for performance, not as the correctness guarantee." DisplayName="Build lstDocNos from Column B, numeric values only" sap:VirtualizedContainerService.HintSize="434,81" sap2010:WorkflowViewState.IdRef="Assign_3">
      <Assign.To>
        <OutArgument x:TypeArguments="scg:List(x:String)">[lstDocNos]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="scg:List(x:String)">[dtReport1.AsEnumerable().Skip(7).Select(Function(r) r(1).ToString.Trim).Where(Function(s) Not String.IsNullOrEmpty(s) AndAlso s.All(AddressOf Char.IsDigit)).Distinct().ToList()]</InArgument>
      </Assign.Value>
    </Assign>
